APP_ENV=development
# Set this to your Neon connection string; keep it server-side and never commit real credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
ACCESS_TOKEN_MINUTES=30
WEB_ORIGINS=http://localhost:3000
GOOGLE_CLIENT_IDS=
# Configure a separate administrator account. Keep the real password only in the backend .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-long-password
UPLOAD_DIRECTORY=uploads
POINTS_SPEND_STEP_KES=100
POINTS_PER_STEP=5
DEMO_PAYMENT_ENABLED=true
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
